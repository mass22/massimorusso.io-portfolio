# Variables d'environnement pour l'envoi d'emails (Resend)
# Copiez ce fichier en .env et remplissez les valeurs

# Clé API Resend (obtenue sur https://resend.com/api-keys)
RESEND_API_KEY=

# Email de destination (votre email admin)
ADMIN_EMAIL=

# Mot de passe admin (pour accéder au dashboard des leads en prod)
ADMIN_PASSWORD=

# Secret pour signer la session admin (cookie)
ADMIN_AUTH_SECRET=

# Email expéditeur (doit être vérifié dans votre compte Resend)
FROM_EMAIL=onboarding@resend.dev

# URL de base de votre site (utilisée pour les liens dans les emails)
BASE_URL=http://localhost:3000/

# Chemin vers la base de données SQLite (optionnel)
# DB_PATH=./data/leads.db
